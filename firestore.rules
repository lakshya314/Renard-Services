rules_version = '2';

// Renard Services – Firestore security rules
// Paste into Firebase Console → Firestore Database → Rules → Publish.
//
// Clients can only read/write their OWN data.
// Clients can create service requests (status "Submitted") and cancel them,
// but only your team (via the Firebase Console or an admin tool) can change
// a request to "In Progress" / "Completed" or add invoices.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      // Profile
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.email == request.auth.token.email;
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'phone', 'company', 'city', 'gstin']);
      allow delete: if false;

      // Service requests
      match /requests/{reqId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.status == 'Submitted'
          && request.resource.data.service is string;
        // Client may only cancel a request that is still "Submitted"
        allow update: if isOwner(uid)
          && resource.data.status == 'Submitted'
          && request.resource.data.status == 'Cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
        allow delete: if false;
      }

      // Uploaded documents (file details)
      match /documents/{docId} {
        allow read, create, delete: if isOwner(uid);
        allow update: if false;
      }

      // Invoices – read-only for clients, added by your team
      match /invoices/{invId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }
  }
}
